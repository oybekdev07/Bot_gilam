# ============ Lokal (VS Code) sozlamalari ============
# Bu fayl namuna. Haqiqiy qiymatlar .env faylida (u GitHub'ga yuklanmaydi).

# Telegram bot tokeni (@BotFather)
BOT_TOKEN=123456:PUT_YOUR_TOKEN_HERE

# Ega Telegram ID (bir nechta bo'lsa vergul bilan: 111,222)
ADMIN_IDS=123456789

# Ma'lumotlar bazasi fayli (ixtiyoriy; standart: data/carpet.db)
# DB_PATH=data/carpet.db

# ---- Google Sheets (faqat «📤 Google Sheetga» tugmasi uchun; ixtiyoriy) ----
GOOGLE_SHEET_ID=
# Service account JSON faylining yo'li (Windows). Qo'shtirnoq kerak emas.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Vaqt zonasi
TIMEZONE=Asia/Tashkent
